# Copiar a .env.local y completar con los valores que imprime `npm run db:start`.
# NEXT_PUBLIC_* llega al navegador — acá solo van valores públicos.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. JAMÁS exponer ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
