# Copiar a .env.local y completar con los valores de `npx supabase status`.
# NEXT_PUBLIC_* llega al navegador — acá solo van valores públicos.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" (sb_publishable_...) — reemplaza a la vieja anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (sb_secret_...) — reemplaza a service_role. Solo servidor,
# JAMÁS exponerla ni prefijarla con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
